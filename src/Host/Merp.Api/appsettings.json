{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:8080/realms/merp",
    "Audience": "merp-api",
    "WebClientId": "merp-web"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Localization": {
    "SupportedCultures": [ "tr-TR" ]
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 1000 },
    "Public": { "PermitLimit": 30 },
    "Ai": { "PermitLimit": 10 }
  },
  "Ai": {
    "Provider": "None",
    "Model": "claude-sonnet-5-5",
    "Defaults": {
      "Enabled": false,
      "Features": [ "*" ],
      "MonthlyBudgetUsd": 0
    }
  },
  "Messaging": {
    "Transport": "InProcess",
    "RabbitMq": {
      "Uri": "amqp://merp:merp@localhost:5672"
    }
  },
  "Jobs": {
    "EnableServer": true,
    "DashboardTenants": []
  },
  "ApiDocs": {
    "Enabled": false
  }
}
