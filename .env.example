# Copy to .env and adjust. docker-compose.yml has the same defaults, so .env is optional in development.

# PostgreSQL
POSTGRES_USER=merp
POSTGRES_PASSWORD=merp
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# RabbitMQ
RABBITMQ_USER=merp
RABBITMQ_PASSWORD=merp
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Keycloak (master realm administrator, http://localhost:8080/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# Mailpit (UI http://localhost:8025, SMTP localhost:1025)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Gotenberg
GOTENBERG_PORT=3000

# Aspire Dashboard (UI http://localhost:18888, OTLP gRPC 4317, OTLP HTTP 4318)
ASPIRE_UI_PORT=18888
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
